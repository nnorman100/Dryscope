# Copy to .env.local for local development. Never commit real values.

# Gemini Developer API key used server-side by /api/scope, /api/analyze-photo
# and the Live walkthrough relay in server.ts. Without it those features refuse
# requests with a clear error (nothing is simulated). In App Hosting this comes
# from the Secret Manager secret `gemini-api-key` (see apphosting.yaml).
GEMINI_API_KEY=

# Google Maps Platform browser key (Maps JavaScript API + Places API New),
# restricted by HTTP referrer to the app's domains. Leave empty to run without
# maps: the address field becomes plain text and map panels show a notice. In
# App Hosting this comes from the secret `maps-api-key` at build time.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional Cloud-based map style ID; the Google demo map ID is used if unset.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Set to true only after the Google provider is enabled in Firebase Auth.
# NEXT_PUBLIC_GOOGLE_SIGN_IN=false
